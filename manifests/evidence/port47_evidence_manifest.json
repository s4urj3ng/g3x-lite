      ]
    },
    {
      "status": "VERIFIED",
      "claim": "NULL/invalid shadow or GUI_NONE rejects restore; allocation is attempted once; layer changes invalidate; failed recovery forces repaint.",
      "evidence": [
        "chdk-port/core/gui_draw.c:121",
